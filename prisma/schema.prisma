// DisLogic — Esquema de base de datos
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Circuito compartido mediante link
model SharedCircuit {
  id        String   @id @default(cuid())
  name      String
  data      String // JSON del circuito (ComponentInstance[] + Wire[])
  author    String   @default("Anónimo")
  views     Int      @default(0)
  createdAt DateTime @default(now())
}
